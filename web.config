<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS: 이 저장소 폴더가 wwwroot 아래에 있어서 소스·설정 파일까지 웹으로 보일 수 있다.
  배포용 클라이언트(apps/client/dist)에 필요한 것만 남기고 나머지는 숨긴다 (요청 시 404).
  게임 주소: http://<호스트>/test/pixi_ai/fortress/apps/client/dist/
  게임 서버는 IIS를 거치지 않고 브라우저가 <호스트>:2567 로 직접 접속한다.
-->
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <security>
      <requestFiltering>
        <!-- 경로 중 이 이름이 하나라도 있으면 숨김 (폴더·파일 이름 모두) -->
        <hiddenSegments>
          <add segment=".git" />
          <add segment=".agents" />
          <add segment=".claude" />
          <add segment="node_modules" />
          <add segment="packages" />
          <add segment="server" />
          <add segment="src" />
          <add segment="public" />
          <add segment="tools" />
          <add segment="docs" />
          <!-- 주의: "images" 는 숨기면 안 된다 (dist/images 를 게임이 쓴다) -->
          <add segment="deploy" />
          <add segment="package.json" />
          <add segment="package-lock.json" />
          <add segment="skills-lock.json" />
          <add segment="tsconfig.json" />
          <add segment="tsconfig.base.json" />
          <add segment="eslint.config.js" />
          <add segment="vite.config.ts" />
        </hiddenSegments>
        <!-- 배포 결과에 없는 소스 형식은 어디서든 막는다 -->
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".ts" allowed="false" />
          <add fileExtension=".mjs" allowed="false" />
          <add fileExtension=".cjs" allowed="false" />
          <add fileExtension=".map" allowed="false" />
          <add fileExtension=".md" allowed="false" />
          <add fileExtension=".env" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
