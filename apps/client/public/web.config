<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS: 빌드 결과(dist) 폴더용. Vite가 public/ 을 dist/ 로 그대로 복사한다.
  - index.html 은 매번 새로 받게 (새 버전 배포가 바로 보이게)
  - assets/ 의 js 는 파일 이름에 해시가 붙어 있어 오래 캐시해도 된다
-->
<configuration>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
