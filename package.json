{
  "name": "fortress",
  "private": true,
  "version": "0.1.0",
  "description": "포트리스 모노레포 (클라이언트 + Colyseus 서버 + 공용 로직)",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm run dev -w @fortress/client --",
    "dev:server": "npm run dev -w @fortress/server",
    "start:server": "npm run start -w @fortress/server",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build:mask": "node tools/build-mask.mjs",
    "server:start": "npm run build && pm2 startOrReload apps/server/ecosystem.config.cjs --env production && pm2 save",
    "server:stop": "pm2 stop fortress-server",
    "server:status": "pm2 status",
    "server:logs": "pm2 logs fortress-server --lines 100"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "pm2": "^7.1.2",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
